# Copia questo file in .env e inserisci i valori reali. Non committare .env.
# Docker Compose legge .env automaticamente. Per esecuzione locale Spring, esporta le variabili o usale nell'IDE.

# ---------- PostgreSQL (obbligatorie per docker-compose) ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=programmers-api

# ---------- Spring Boot in locale (senza Docker) ----------
# Impostale se avvii l'app da IDE o da mvn spring-boot:run contro un Postgres locale.
# Esempio con Postgres in locale sulla porta 5434:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/programmers-api
# SPRING_DATASOURCE_USERNAME=tuo_user
# SPRING_DATASOURCE_PASSWORD=tua_password

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
